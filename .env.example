PORT=4020

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=exhi_zone

# Comma-separated list of origins allowed to call this API
# http://localhost:3020 -> Exhibitor Zone frontend (Next.js dev/start)
CORS_ORIGIN=http://localhost:3020

# SMTP settings for exhibitor-zone emails (welcome, password reset, admin
# notifications). Leave SMTP_HOST blank to skip sending emails entirely —
# actions still succeed either way, nothing surfaces a mail failure to the user.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AES-256-GCM key (64 hex chars / 32 bytes) for encrypted PII columns (gst_number_enc, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: if you migrated data from an existing database, you MUST use that database's
# original key here — a new key cannot decrypt already-encrypted columns.
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ez_session
SESSION_TTL_DAYS=7
# Local-disk storage only (company documents, form attachments) — no S3/GCS wired up.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Used to build the password-reset link emailed to exhibitor users.
FRONTEND_BASE_URL=http://localhost:3020
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Razorpay — powers cart checkout payment (POST /payments/checkout/:orderId)
# and payment verification. Get these from Dashboard > Settings > API Keys.
# Use the rzp_test_ key pair while testing, swap in the rzp_live_ pair for
# production. Leave blank to keep online payments disabled (checkout still
# creates orders as unpaid; admins can mark them paid manually as before).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > add endpoint pointing at
# <API_BASE_URL>/api/exhibitor-zone/payments/webhook, subscribed to at least
# payment.captured and payment.failed. Paste its signing secret here.
RAZORPAY_WEBHOOK_SECRET=
